---
import Base from '../layouts/Base.astro';
import ProjectRow from './ProjectRow.astro';
import { SITE } from '../site.config.mjs';
import { t, localePath, type Lang } from '../i18n/ui';
import { getProjects, byGroup } from '../lib/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const sections = byGroup(await getProjects(lang));
---
<Base lang={lang}>
  <section class="intro wrap">
    <h1 class="fade">{SITE.name[lang]}</h1>
    <p class="role fade d1">{SITE.role[lang]}</p>
    <p class="bio fade d1">{SITE.bio[lang]}</p>
    <div class="links fade d2">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      {SITE.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
      <a href={localePath(lang, '/usage/')}>{s.usage.title} →</a>
    </div>
    <nav class="index fade d3" aria-label="sections">
      {sections.map(({ group, items }) => (
        <a href={`#${group}`}>{s.groups[group].title}<b>{items.length}</b></a>
      ))}
    </nav>
  </section>

  {sections.map(({ group, items }, i) => (
    <section class="group wrap" id={group}>
      <div class="group-head">
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <h2>{s.groups[group].title}</h2>
        <span class="desc">{s.groups[group].desc}</span>
      </div>
      <ul class="rows">
        {items.map((p) => <ProjectRow project={p} lang={lang} />)}
      </ul>
    </section>
  ))}
</Base>
