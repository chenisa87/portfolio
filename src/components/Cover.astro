---
import { hueOf } from '../lib/projects';
interface Props { src?: string; title: string; slug: string; eager?: boolean }
const { src, title, slug, eager = false } = Astro.props;
// Placeholder monogram: first two CJK characters, else initials of the first two words
const cjk = title.match(/[㐀-鿿]/g);
const words = title.replace(/[^A-Za-z0-9\s]/g, ' ').trim().split(/\s+/).filter(Boolean);
const initials =
  cjk && cjk.length >= 2
    ? cjk.slice(0, 2).join('')
    : words.slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '✦';
---
<div class="cover">
  {src ? (
    <img src={src} alt={title} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="placeholder" style={`--h:${hueOf(slug)}`}><span>{initials}</span></div>
  )}
</div>
