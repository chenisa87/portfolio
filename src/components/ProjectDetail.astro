---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, localePath, formatDate, type Lang } from '../i18n/ui';
import { youtubeId, type Project } from '../lib/projects';

interface Props { lang: Lang; project: Project; prev?: Project; next?: Project }
const { lang, project, prev, next } = Astro.props;
const s = t(lang);
const d = project.data;
const { Content } = await render(project);
const yt = d.video ? youtubeId(d.video) : null;
const group = s.groups[d.group];
const home = localePath(lang, '/') + `#${d.group}`;
const href = (p: Project) => localePath(lang, `/projects/${p.slug}/`);
const hasMedia = Boolean(d.video || d.cover || d.images.length);
---
<Base lang={lang} title={d.title} description={d.summary} image={d.cover}>
  <article class="article">
    <div class="wrap">
      <a class="crumb" href={home}>← {group.title}</a>

      <div class="kicker fade">
        <span>{group.title}</span>
        {d.category && <><span class="sep">/</span><span>{d.category}</span></>}
        <span class="sep">/</span>
        <span>{formatDate(d.date, lang)}</span>
        <span class:list={['pill', d.status]}>{s.status[d.status]}</span>
      </div>
      <h1 class="fade d1">{d.title}</h1>
      <p class="lead fade d1">{d.summary}</p>
      {!project.translated && lang === 'en' && <p class="notice">{s.untranslated}</p>}

      {(d.demo || d.repo) && (
        <div class="actions fade d2">
          {d.demo && <a class="btn primary" href={d.demo} target="_blank" rel="noopener">{s.demo} ↗</a>}
          {d.repo && (
            <a class="btn" href={d.repo} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
              {s.source}
            </a>
          )}
        </div>
      )}

      {d.tags.length > 0 && <p class="stack fade d2">{d.tags.map((tag) => <span>{tag}</span>)}</p>}
    </div>

    {hasMedia && (
      <div class="media wrap wide fade d3">
        {(yt || d.video || d.cover) && (
          <div class="frame">
            {yt ? (
              <div class="embed">
                <iframe src={`https://www.youtube-nocookie.com/embed/${yt}`} title={d.title} loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
            ) : d.video ? (
              <video src={d.video} controls playsinline preload="metadata" poster={d.cover}></video>
            ) : (
              <img src={d.cover} alt={d.title} decoding="async" />
            )}
          </div>
        )}
        {d.images.length > 0 && (
          <div class="gallery" aria-label={s.gallery}>
            {d.images.map((src, i) => (
              <a href={src} target="_blank" rel="noopener"><img src={src} alt={`${d.title} ${i + 1}`} loading="lazy" /></a>
            ))}
          </div>
        )}
      </div>
    )}

    <div class="wrap">
      <hr class="divider" />
      <div class="prose"><Content /></div>

      {(prev || next) && (
        <nav class="pager" aria-label="pagination">
          {prev && <a href={href(prev)}><small>← {s.prev}</small>{prev.data.title}</a>}
          {next && <a class="next" href={href(next)}><small>{s.next} →</small>{next.data.title}</a>}
        </nav>
      )}
    </div>
  </article>
</Base>
