---
import Cover from './Cover.astro';
import { t, localePath, formatDate, type Lang } from '../i18n/ui';
import type { Project } from '../lib/projects';
interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const s = t(lang);
const d = project.data;
const href = localePath(lang, `/projects/${project.slug}/`);
const searchText = [d.title, d.summary, d.category ?? '', ...d.tags].join(' ').toLowerCase();
---
<article
  class:list={['card', { featured: d.featured }]}
  data-tags={d.tags.join('|')}
  data-search={searchText}
>
  <Cover src={d.cover} title={d.title} slug={project.slug} eager={d.featured} />
  <div class="card-body">
    <div class="card-meta">
      <span>{formatDate(d.date, lang)}{d.category && ` · ${d.category}`}</span>
      <span>
        {d.featured && <span class="badge star">★ {s.featured}</span>}{' '}
        <span class:list={['badge', d.status]}>{s.status[d.status]}</span>
      </span>
    </div>
    <h3><a href={href}>{d.title}</a></h3>
    <p>{d.summary}</p>
    {d.tags.length > 0 && (
      <div class="tags">{d.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
    )}
  </div>
</article>
