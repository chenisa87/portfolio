---
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const list = await getProjects('zh');
  return list.map((project) => {
    const same = list.filter((p) => p.data.group === project.data.group);
    const i = same.indexOf(project);
    return { params: { slug: project.slug }, props: { project, prev: same[i - 1], next: same[i + 1] } };
  });
}
const { project, prev, next } = Astro.props;
---
<ProjectDetail lang="zh" project={project} prev={prev} next={next} />
